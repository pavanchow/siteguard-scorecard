---
import '../styles/global.css';

export interface Props {
  workerUrl: string;
}

const { workerUrl = 'http://localhost:8787' } = Astro.props;
---

<!doctype html>
<html lang="en" class="dark">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content="Scan your website for security vulnerabilities and get a comprehensive security scorecard" />
    <title>SiteGuard Scorecard - Website Security Scanner</title>
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  </head>
  <body class="bg-dark-900 text-white min-h-screen">
    <div class="container mx-auto px-4 py-8 max-w-6xl">
      <header class="mb-12 text-center">
        <h1 class="text-5xl font-bold mb-4 bg-gradient-to-r from-blue-400 to-green-400 bg-clip-text text-transparent">
          SiteGuard Scorecard
        </h1>
        <p class="text-gray-400 text-lg max-w-2xl mx-auto">
          Comprehensive website security scanning tool. Enter a URL to analyze security headers,
          TLS configuration, exposed files, and potential vulnerabilities.
        </p>
      </header>

      <main id="app" data-worker-url={workerUrl}>
        <!-- React app will hydrate here -->
      </main>

      <footer class="mt-16 text-center text-gray-500 text-sm">
        <p>&copy; 2024 SiteGuard Scorecard. Built with Astro, React, and Cloudflare Workers.</p>
      </footer>
    </div>

    <script type="module" src="../scripts/main.tsx"></script>
  </body>
</html>

---
import '../styles/global.css';
import App from '../components/App';

const workerUrl = import.meta.env.PUBLIC_WORKER_URL ?? 'http://localhost:8787';
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---

<!doctype html>
<html lang="en" class="dark">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>SiteGuard Scorecard: website security scanner and scorecard | Pavan Nallamothu</title>
    <meta name="description" content="SiteGuard Scorecard is a website security scanner that grades a site A-F across security headers, cookie flags, exposed files, TLS configuration, mixed content, and subdomain-takeover risk. By Pavan Nallamothu." />
    <meta name="author" content="Pavan Nallamothu" />
    <link rel="canonical" href="https://pavanchow.github.io/siteguard-scorecard/" />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Pavan Nallamothu" />
    <meta property="og:locale" content="en_US" />
    <meta property="og:title" content="SiteGuard Scorecard: website security scanner and scorecard | Pavan Nallamothu" />
    <meta property="og:description" content="SiteGuard Scorecard is a website security scanner that grades a site A-F across security headers, cookie flags, exposed files, TLS configuration, mixed content, and subdomain-takeover risk. By Pavan Nallamothu." />
    <meta property="og:url" content="https://pavanchow.github.io/siteguard-scorecard/" />
    <meta name="twitter:card" content="summary_large_image" />
    <script type="application/ld+json" set:html={JSON.stringify({"@context":"https://schema.org","@graph":[
      {"@type":"Person","@id":"https://github.com/pavanchow#person","name":"Pavan Nallamothu","alternateName":"pavanchow","url":"https://github.com/pavanchow","jobTitle":"Software Engineer and Security Researcher","sameAs":["https://github.com/pavanchow","https://hackerone.com/pavanchow","https://www.linkedin.com/in/pavanchow/","https://orcid.org/0009-0009-1481-6629"]},
      {"@type":"SoftwareApplication","@id":"https://pavanchow.github.io/siteguard-scorecard/#software","name":"SiteGuard Scorecard","applicationCategory":"DeveloperApplication","operatingSystem":"Linux, macOS, Windows","description":"SiteGuard Scorecard is a website security scanner that grades a site A-F across security headers, cookie flags, exposed files, TLS configuration, mixed content, and subdomain-takeover risk. By Pavan Nallamothu.","url":"https://pavanchow.github.io/siteguard-scorecard/","programmingLanguage":"Astro, TypeScript, JavaScript","codeRepository":"https://github.com/pavanchow/siteguard-scorecard","author":{"@id":"https://github.com/pavanchow#person"},"publisher":{"@id":"https://github.com/pavanchow#person"},"keywords":"website security scanner, security scorecard, security headers, HSTS, CSP, cookie flags, TLS check, mixed content, subdomain takeover, Astro, Cloudflare Workers, Pavan Nallamothu, pavanchow","offers":{"@type":"Offer","price":"0","priceCurrency":"USD"},"license":"https://opensource.org/licenses/MIT"},
      {"@type":"WebSite","@id":"https://pavanchow.github.io/siteguard-scorecard/#website","name":"SiteGuard Scorecard by Pavan Nallamothu","url":"https://pavanchow.github.io/siteguard-scorecard/","author":{"@id":"https://github.com/pavanchow#person"}},
      {"@type":"BreadcrumbList","itemListElement":[{"@type":"ListItem","position":1,"name":"Pavan Nallamothu","item":"https://github.com/pavanchow"},{"@type":"ListItem","position":2,"name":"SiteGuard Scorecard","item":"https://pavanchow.github.io/siteguard-scorecard/"}]},
      {"@type":"WebPage","@id":"https://pavanchow.github.io/siteguard-scorecard/","url":"https://pavanchow.github.io/siteguard-scorecard/","name":"SiteGuard Scorecard: website security scanner and scorecard | Pavan Nallamothu","isPartOf":{"@id":"https://pavanchow.github.io/siteguard-scorecard/#website"},"about":{"@id":"https://pavanchow.github.io/siteguard-scorecard/#software"},"author":{"@id":"https://github.com/pavanchow#person"},"inLanguage":"en"}
    ]})} />
    <link rel="icon" type="image/svg+xml" href={`${base}/favicon.svg`} />
  </head>
  <body class="bg-dark-900 text-white min-h-screen">
    <div class="container mx-auto px-4 py-8 max-w-6xl">
      <header class="mb-12 text-center">
        <h1 class="text-5xl font-bold mb-4 bg-gradient-to-r from-blue-400 to-green-400 bg-clip-text text-transparent">
          SiteGuard Scorecard
        </h1>
        <p class="text-gray-400 text-lg max-w-2xl mx-auto">
          Comprehensive website security scanning tool. Enter a URL to analyze security headers,
          TLS configuration, exposed files, and potential vulnerabilities.
        </p>
      </header>

      <main>
        <noscript>
          <p class="text-gray-400 text-center">
            SiteGuard Scorecard is a website security scanner that grades a site A-F
            across security headers, cookie flags, exposed files, TLS configuration,
            mixed content, and subdomain-takeover risk. By Pavan Nallamothu.
          </p>
        </noscript>
        <App client:only="react" workerUrl={workerUrl} />
      </main>

      <footer class="mt-16 text-center text-gray-500 text-sm">
        <p>&copy; 2024 SiteGuard Scorecard. Built with Astro, React, and Cloudflare Workers.</p>
        <p class="mt-2"><a href="https://pavanchow.github.io/" class="hover:text-gray-300 underline">More projects by Pavan Nallamothu</a></p>
      </footer>
    </div>
  </body>
</html>
